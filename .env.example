# --- Required ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying

# Public URL of the portal (stamped into OAuth tokens and discovery docs).
# Must be https:// in production, no trailing slash.
# Example: https://sewasetu.koreacentral.cloudapp.azure.com
PUBLIC_BASE_URL=https://YOUR-LABEL.koreacentral.cloudapp.azure.com

# Hostname only (no scheme) — used by Caddy for TLS certificate.
# Must match the host part of PUBLIC_BASE_URL.
PUBLIC_HOST=YOUR-LABEL.koreacentral.cloudapp.azure.com

# Shared secret for internal API calls between MCP servers and the portal.
INTERNAL_API_KEY=change-me-random-string

# --- Optional (evals only) ---
ANTHROPIC_API_KEY=sk-ant-...
